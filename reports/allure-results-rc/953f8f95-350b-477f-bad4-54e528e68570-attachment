            <div data-pf-expandable="true" data-pf-type="Accordion.Content" class="sc-dcJtft hDKXay" style="display: none;">
             <div class="sc-jXbVAB kNtuek pf-r pf-r-eh" draggable="true" data-pf-type="Row" style="--s-xs: 15px; --s-lg: 0px;">
