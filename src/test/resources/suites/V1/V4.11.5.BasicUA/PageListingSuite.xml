<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="V4.11.5 Basic UAT">

    <listeners>
        <listener class-name="org.pftest.listeners.AnnotationTransformer"/>
        <listener class-name="org.pftest.listeners.TestListener"/>
    </listeners>

    <test name="Page Listing" verbose="2" preserve-order="true">
        <classes>
            <class name="org.pftest.projects.V1.testcases.PageListingTest">
                <methods>
                    <include name="createNewTemplateProductPage"/>
                    <include name="unpublishPageInThePageListingScreen"/>
                    <include name="publishPageInThePageListingScreen"/>
                    <include name="duplicatePageInThePageListingScreen"/>
                    <include name="deletePageInThePageListingScreen"/>
                    <include name="exportSelectedPageInThePageListingScreen"/>
                    <include name="exportAllPagesInThePageListingScreen"/>
                    <include name="importPageInThePageListingScreen"/>
                    <include name="importPageExportedFromOtherStore"/>
                </methods>
            </class>

            <class name="org.pftest.projects.V1.testcases.PageEditingTest">
                <methods>
                    <include name="changeCanvasWidthInEditor"/>
                    <include name="enableAutoSaveWhenHaventSavedPage"/>
                    <include name="enableAutoSaveWhenHaveSavedPage"/>
                    <include name="addAndEditSlideShow"/>
                </methods>
            </class>

            <class name="org.pftest.projects.V1.testcases.UndoRedoTest">
                <methods>
                    <include name="restorePreviousVersion_TC044"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>